   "source": [
    "from IPython.core.debugger import set_trace\n",
    "\n",
    "def average(nums):\n",
    "    total = 0\n",
    "    set_trace() # Set breakpoint here\n",
    "    for n in nums:\n",
    "        total += n\n",
    "    return total / len(nums)"
   ]
